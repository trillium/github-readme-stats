[Unit]
Description=Local github-readme-stats renderer (loopback only)
After=network-online.target
Wants=network-online.target
# Without a token the renderer can only produce error cards; install.sh explains how to add one.
ConditionFileNotEmpty=/etc/stats-cache/renderer.env

[Service]
User=statscache
Group=statscache
WorkingDirectory=/opt/stats-cache/app
# renderer.env is root-owned 0600 and holds PAT_1; systemd reads it, the service user cannot.
EnvironmentFile=/etc/stats-cache/renderer.env
# Set on the command line because EnvironmentFile= values override Environment=;
# env(1) applies these last, so renderer.env cannot move the listener off 127.0.0.1:9000.
ExecStart=/usr/bin/env NODE_ENV=production port=9000 host=127.0.0.1 /usr/bin/node express.js
Restart=on-failure
RestartSec=5
MemoryMax=256M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
