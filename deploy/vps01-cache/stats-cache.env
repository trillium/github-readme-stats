# Settings for stats-cache-refresh (installed as /etc/stats-cache/stats-cache.env).
UPSTREAM_BASE=https://trillium-github-readme-stats.vercel.app
# A copy older than this is refreshed on the next visit or timer run.
FRESH_SECONDS=3600
# Never contact the upstream for a card more than once per this many seconds
# (also after failures), however much traffic arrives.
MIN_RETRY_SECONDS=120
FETCH_TIMEOUT=20
